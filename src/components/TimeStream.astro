---
import { streamBands } from '../data/time-stream.mjs';
import '../styles/time-stream.css';
---

<section class="time-stream" aria-labelledby="time-stream-title">
  <header class="time-stream__header">
    <div>
      <p>TIME / LIFE DISTRIBUTION</p>
      <h2 id="time-stream-title">时间流向哪里？</h2>
    </div>
    <p>把日常折叠成一条不断变化的河流，<br />看看注意力在不同阶段如何重新分配。</p>
  </header>

  <div class="time-stream__chart">
    <div class="time-stream__canvas" tabindex="0" aria-label="横向滚动查看完整时间流图">
      <svg class="time-stream__svg" viewBox="0 0 1200 460" role="img" aria-labelledby="time-stream-chart-title time-stream-chart-desc">
        <title id="time-stream-chart-title">时间分配流图</title>
        <desc id="time-stream-chart-desc">展示社交家庭、编程工作、游戏、音乐运动与学习五类活动随年龄变化的示意图。</desc>

        {streamBands.map((layer) => (
          <g class={`stream-layer stream-layer--${layer.key}`} tabindex="0">
            <title>{layer.title}</title>
            <path d={layer.path}></path>
            <text x={layer.x} y={layer.y}>{layer.label}</text>
          </g>
        ))}

        <g class="time-stream__axis" aria-hidden="true">
          <text x="0" y="451">18</text><text x="238" y="451">22</text><text x="478" y="451">26</text>
          <text x="718" y="451">30</text><text x="958" y="451">34</text><text x="1180" y="451">38</text>
          <text class="time-stream__age" x="600" y="451">AGE</text>
        </g>
      </svg>
    </div>
    <div class="time-stream__legend" aria-label="图例">
      <span><i class="legend-family"></i>社交 / 家庭</span>
      <span><i class="legend-work"></i>编程 / 工作</span>
      <span><i class="legend-game"></i>游戏</span>
      <span><i class="legend-movement"></i>音乐 / 运动</span>
      <span><i class="legend-study"></i>学习</span>
    </div>
  </div>
</section>
