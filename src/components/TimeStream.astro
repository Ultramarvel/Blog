---
import { streamBands } from '../data/time-stream.mjs';
import '../styles/time-stream.css';
---

<section class="time-stream" aria-labelledby="time-stream-title">
  <header class="time-stream__header">
    <div>
      <p>TIME / LIFE DISTRIBUTION</p>
      <h2 id="time-stream-title">时间流向哪里？</h2>
    </div>
    <p>把日常折叠成一条不断变化的河流，<br />看看注意力在不同阶段如何重新分配。</p>
  </header>

  <div class="time-stream__chart">
    <div class="time-stream__canvas" tabindex="0" aria-label="横向滚动查看完整时间流图">
      <svg class="time-stream__svg" viewBox="0 0 1200 420" role="img" aria-labelledby="time-stream-chart-title time-stream-chart-desc">
        <title id="time-stream-chart-title">时间分配流图</title>
        <desc id="time-stream-chart-desc">展示社交家庭、编程工作、游戏、音乐运动与学习五类活动随年龄变化的示意图。</desc>

        {streamBands.map((layer) => (
          <g id={`stream-${layer.key}`} class={`stream-layer stream-layer--${layer.key}`}>
            <title>{layer.title}</title>
            <path d={layer.path}></path>
            <text x={layer.x} y={layer.y}>{layer.label}</text>
          </g>
        ))}

      </svg>
    </div>
    <p class="time-stream__axis-label">AGE</p>
    <div class="time-stream__legend" aria-label="图例">
      <button type="button" data-stream-target="family" aria-controls="stream-family"><i class="legend-family"></i>社交 / 家庭</button>
      <button type="button" data-stream-target="work" aria-controls="stream-work"><i class="legend-work"></i>编程 / 工作</button>
      <button type="button" data-stream-target="game" aria-controls="stream-game"><i class="legend-game"></i>游戏</button>
      <button type="button" data-stream-target="movement" aria-controls="stream-movement"><i class="legend-movement"></i>音乐 / 运动</button>
      <button type="button" data-stream-target="study" aria-controls="stream-study"><i class="legend-study"></i>学习</button>
    </div>
  </div>
</section>
