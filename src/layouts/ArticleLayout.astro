---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../../article.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  sections: Heading[];
}

const { post, next, sections } = Astro.props;
const data = post.data;
const dateISO = data.publishedAt.toISOString().slice(0, 10);
const dateChinese = `${data.publishedAt.getFullYear()}年${data.publishedAt.getMonth() + 1}月${data.publishedAt.getDate()}日`;
---

<BaseLayout title={`${data.title} — 林间信号`} description={data.summary} bodyClass="article-page">
  <div class="reading-progress"><span></span></div>
  <main class="article-shell">
    <div class="article-layout">
      <div class="article-main">
        <a class="back-link" href="/#notes"><span aria-hidden="true">←</span>返回文章列表</a>
        <header class="article-header">
          <div class="article-header-tags">
            <span># {data.category}</span>
            <span># Markdown</span>
          </div>
          <h1>{data.title}</h1>
          <div class="article-meta">
            <time datetime={dateISO}>{dateChinese}</time>
            <i aria-hidden="true"></i>
            <span>{data.readingMinutes} 分钟阅读</span>
            <i aria-hidden="true"></i>
            <span>{data.views} 阅读</span>
          </div>
          <div class="article-header-rule" aria-hidden="true"><span>✦</span><i></i></div>
        </header>
        <p class="article-deck">{data.summary}</p>
        <article class="prose" id="article-content">
          <slot />
          <footer class="article-content-footer">
            <div class="article-end">✳</div>
            <div class="article-tags"><span>{data.category}</span><span>Markdown</span></div>
            <div class="author-card">
              <div class="author-avatar">{data.author.slice(0, 1)}</div>
              <div><strong>{data.author}</strong><p>把好奇心种进日常。记录设计、技术与生活里微小但重要的事。</p></div>
              <a href="/about/">更多关于{data.author} ↗</a>
            </div>
            {next && (
              <a class="next-article" href={`/posts/${next.id}/`}>
                <span>下一篇 →</span><strong>{next.data.title}</strong>
              </a>
            )}
          </footer>
        </article>
      </div>
      <aside class="toc" aria-label="文章目录">
        <p class="toc-title">ON THIS PAGE</p>
        <nav class="toc-list">
          {sections.map((heading, index) => (
            <a
              href={`#${heading.slug}`}
              class={`toc-link toc-link--h${heading.depth}${index === 0 ? ' current' : ''}`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
        <span class="toc-read-time">{data.readingMinutes} MIN READ</span>
      </aside>
    </div>
  </main>
  <script>
    import '../../article.js';
  </script>
</BaseLayout>
