---
import '../../styles.css';
import '../styles/profile.css';
import BlobCursor from '../components/BlobCursor.jsx';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = '林间信号 — 关于设计、技术与日常观察的个人笔记。',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111311" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
  </head>
  <body class={bodyClass} id="top">
    <div class="grain" aria-hidden="true"></div>
    <BlobCursor
      client:load
      blobType="circle"
      fillColor="#b6d957"
      trailCount={3}
      sizes={[52, 96, 68]}
      innerSizes={[11, 18, 13]}
      innerColor="rgba(248, 250, 235, .72)"
      opacities={[0.44, 0.2, 0.28]}
      shadowColor="rgba(0, 0, 0, .32)"
      shadowBlur={10}
      shadowOffsetX={6}
      shadowOffsetY={8}
      filterStdDeviation={18}
      useFilter={true}
      fastDuration={0.12}
      slowDuration={0.48}
      zIndex={9}
    />
    <header class="topbar">
      <a class="brand" href="/" aria-label="林间信号首页">
        <span class="brand-mark">L<span>✳</span></span>
        <span>林间信号<small>FIELD NOTES / 2026</small></span>
      </a>
      <nav class="nav-links" aria-label="主导航">
        <a href="/#notes">文章</a>
        <a href="/about/">关于</a>
        <a href="/admin/">管理 ↗</a>
      </nav>
      <button class="theme-toggle" aria-label="切换色彩模式" title="切换色彩模式"><span></span></button>
    </header>
    <slot />
    <footer class="footer">
      <a class="brand" href="#top">
        <span class="brand-mark">L<span>✳</span></span>
        <span>林间信号<small>FIELD NOTES / 2026</small></span>
      </a>
      <span class="footer-meta">
        <span>© 2026 LIN · SHANGHAI</span>
        <span class="footer-stats" aria-label="网站访问统计">
          总访问 <span id="busuanzi_site_pv">--</span> · 访客 <span id="busuanzi_site_uv">--</span>
        </span>
      </span>
    </footer>
    <script>
      import '../../script.js';
    </script>
  </body>
</html>
