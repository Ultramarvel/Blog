---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-orbits.css';

const [loadedPosts, profiles] = await Promise.all([
  getCollection('posts'),
  getCollection('profile'),
]);
const profile = profiles[0];
const posts = loadedPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = posts.find((post) => post.data.featured) ?? posts[0];
const remaining = posts.filter((post) => post.id !== featured?.id);
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title="林间信号 — Notes from elsewhere">
  <main>
    <section class="hero hero--orbit-only" aria-label="观察者动态轨道">
      <div class="hero-art hero-art--circles" data-orbit-profile aria-label="动态同心圆观察轨道" role="img">
        <div class="art-label label-top">OBSERVATION No. 026</div>
        {profile && (
          <div class="orbit-profile" aria-hidden="true">
            <span class="orbit-circle orbit-circle--outer"></span>
            <span class="orbit-circle orbit-circle--middle"></span>
            <span class="orbit-circle orbit-circle--inner"></span>
            <div class="orbit-carrier orbit-carrier--idea">
              <div class="orbit-badge"><b>✦</b><small>IDEA</small></div>
            </div>
            <div class="orbit-carrier orbit-carrier--field">
              <div class="orbit-badge"><b>✳</b><small>FIELD</small></div>
            </div>
            <div class="orbit-carrier orbit-carrier--signal">
              <div class="orbit-badge"><i></i><small>SIGNAL</small></div>
            </div>
            <div class="orbit-card-panel">
              <div class="orbit-card-panel__meta"><span>OBSERVER ID</span><span>{profile.data.profileNumber}</span></div>
              <p>你好，我是</p>
              <strong>{profile.data.name}</strong>
              <div class="orbit-card-panel__rule"></div>
              <small>正在观察</small>
              <ul>{profile.data.topics.slice(0, 3).map((topic) => <li>{topic}</li>)}</ul>
              <footer><span>{profile.data.location}</span><span>ACTIVE</span></footer>
            </div>
          </div>
        )}
        <div class="art-label label-bottom">{profile?.data.coordinates ?? '31° 13′ N / 121° 28′ E'}</div>
      </div>
      <div class="hero-index"><span>01</span><span class="index-line"></span><span>SCROLL TO EXPLORE</span></div>
    </section>

    <section class="notes-section" id="notes">
      <div class="section-heading">
        <div><p class="eyebrow">THE JOURNAL <span>— 近期记录</span></p><h2>最近在想<span class="accent">什么</span></h2></div>
        <a class="archive-link" href="#archive">浏览全部 <span>↗</span></a>
      </div>
      {featured ? (
        <div class="featured-card">
          <a class="featured-visual" href={`/posts/${featured.id}/`} aria-label={`阅读${featured.data.title}`}>
            <div class="visual-grid"></div><div class="visual-sun"></div><div class="visual-orbit"></div><div class="visual-orbit second"></div>
            <span class="visual-caption">GENERATED COVER — NO IMAGE ASSET</span><span class="visual-number">01</span>
          </a>
          <div class="featured-copy">
            <div class="post-meta"><span>{featured.data.category}</span><i>·</i><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time><span class="read-time">{featured.data.readingMinutes} MIN READ</span></div>
            <h3><a href={`/posts/${featured.id}/`}>{featured.data.title}</a></h3>
            <p>{featured.data.summary}</p>
            <a class="round-arrow" href={`/posts/${featured.id}/`} aria-label="阅读全文">↗</a>
          </div>
        </div>
      ) : (
        <p class="empty-state">还没有已发布的文章。可以前往 <a href="/admin/">管理后台</a> 创建第一篇。</p>
      )}
      <div class="post-list" id="archive">
        {remaining.map((post, index) => (
          <a class="post-row" href={`/posts/${post.id}/`}>
            <span class="row-number">{String(index + 2).padStart(2, '0')}</span>
            <span class="row-title">{post.data.title}</span><span class="row-tag">{post.data.category}</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span class="row-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    {profile && (
      <section class="profile-preview" id="about">
        <div class="profile-preview__topline">
          <span>OBSERVER PROFILE / {profile.data.profileNumber}</span>
          <span>IDENTITY SIGNAL · ACTIVE</span>
        </div>
        <div class="profile-preview__grid">
          <div class="profile-sigil" aria-hidden="true">
            <span class="profile-sigil__orbit profile-sigil__orbit--one"></span>
            <span class="profile-sigil__orbit profile-sigil__orbit--two"></span>
            <span class="profile-sigil__dot"></span>
            <strong>{profile.data.initials}</strong>
          </div>
          <div class="profile-preview__copy">
            <p class="profile-kicker">你好，我是{profile.data.name}。</p>
            <h2>{profile.data.tagline}</h2>
            <p>{profile.data.shortBio}</p>
            <div class="profile-actions">
              <a class="text-link" href="/about/">完整介绍 <span>↗</span></a>
              <a class="text-link profile-actions__secondary" href={`mailto:${profile.data.email}`}>给我写信 <span>↗</span></a>
            </div>
          </div>
          <div class="profile-facts">
            <div><span>BASE</span><strong>{profile.data.location}</strong><small>{profile.data.coordinates}</small></div>
            <div><span>FIELD</span><strong>{profile.data.topics.slice(0, 3).join(' / ')}</strong></div>
            <div class="profile-signal"><span>CURRENT SIGNAL</span><strong>{profile.data.status}</strong><i></i></div>
            <div><span>SINCE</span><strong>{profile.data.since}</strong></div>
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
